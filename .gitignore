# Local-only env files for compose stack (e.g. .env.dev, .env.local, .env.testnet).
# Keep .env.example tracked (negation below).
.env.*
!.env.example
!**/.env.example
# Mainnet-pointer templates (present-and-blank; NO secrets) must be committable.
!.env.mainnet.example
!**/.env.mainnet.example
*storybook.log
*storybook-static
.tsbuildinfo
.eslintcache
*.pem
*.local.md

# Compound-engineering session artifacts (brainstorms, plans, solutions)
# Produced by /ce-brainstorm, /ce-plan, /ce-compound, /ce-doc-review, etc.
# Ignored by default; force-add (git add -f) when a doc is worth committing.
docs/brainstorms
docs/plans
docs/solutions

# package-specific ignores
packages/sdk/test/test.test.ts
packages/sdk/test/**/debug-*.json
packages/contracts/contracts/**/*/target/
# Circuits keep tracked test fixtures (target/proof/, target/vk/) generated by
# packages/sdk/scripts/jwt/generate-zkjwt-proof.mjs, so we only ignore the regenerable
# nargo outputs at the top level of target/ — not its subdirectories.
packages/contracts/circuits/**/target/*.json
packages/contracts/circuits/**/target/*.gz
packages/contracts/**/codegenCache.json
packages/launch-campaign-web/circuits/**/target/
packages/contracts/src/artifacts/target/
# Locally built bootstrap artifact manifests; the store is the record, only the README is tracked.
packages/backend/config-service/artifacts/*/
# patchAndCompilePaylink + deploy Step G back up .nr sources before in-place patching;
# normally cleaned up by restorePatch() but linger after crashes/interrupts.
packages/contracts/contracts/**/*.nr.bak
# Per-sandbox generated artifacts (config profile + oxide manifest), regenerated by sandbox-up.sh
packages/backend/config-service/generated/
# Legacy generated-manifest home — stale copies linger on machines that ran older checkouts
packages/backend/address-registry/
packages/backend/scripts/mint-fee-juice.ts
packages/backend/ens-gateway/data/
# Per-run deploy output (uploaded as a workflow artifact; a committed copy
# makes failed runs lie in the workflow summary)
packages/backend/ens-gateway/scripts/sepolia-ens-deployment.json
packages/wallet-web/public/*.wasm
# web-wallet-desktop: served bundle + build meta produced by scripts/build-web.sh
packages/web-wallet-desktop/web/
packages/web-wallet-desktop/build-meta.json
packages/web-wallet-desktop/config/generated.json

coverage/

tsconfig.tsbuildinfo

