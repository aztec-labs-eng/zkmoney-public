{
  "name": "@obsidion/sdk",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "author": "porco",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./test": {
      "import": "./dist/test.js",
      "require": "./dist/test.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.js",
      "require": "./dist/backend.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "clean": "rm -rf ./dist .tsbuildinfo",
    "verify-live-decimals": "tsx scripts/verify-live-decimals.ts",
    "generate:malformed-jwt": "tsx scripts/generate-malformed-jwt-fixtures.mjs",
    "sync:malformed-jwt": "tsx scripts/sync-malformed-jwt-to-noir.mjs",
    "prove:zkjwt": "node scripts/generate-zkjwt-proof.mjs",
    "prove:zkjwt:bb": "node scripts/generate-zkjwt-proof.mjs --prove",
    "test": "CI=true vitest run",
    "test:coverage": "vitest run --coverage scripts/debugInnerHash.test.ts scripts/computeDomainSeparator.test.ts",
    "validate:script": "./validate-script.sh run-tests.sh",
    "test:with-validation": "npm run validate:script && ./run-tests.sh",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "gas:record": "./scripts/record-claimfpc-gas.sh"
  },
  "dependencies": {
    "@aztec/accounts": "v5.2.0",
    "@aztec/aztec.js": "v5.2.0",
    "@aztec/constants": "v5.2.0",
    "@aztec/entrypoints": "v5.2.0",
    "@aztec/ethereum": "v5.2.0",
    "@aztec/foundation": "v5.2.0",
    "@aztec/kv-store": "v5.2.0",
    "@aztec/l1-artifacts": "v5.2.0",
    "@aztec/noir-contracts.js": "v5.2.0",
    "@aztec/noir-protocol-circuits-types": "v5.2.0",
    "@aztec/protocol-contracts": "v5.2.0",
    "@aztec/pxe": "v5.2.0",
    "@aztec/stdlib": "v5.2.0",
    "@aztec/wallet-sdk": "v5.2.0",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.4.0",
    "@noble/secp256k1": "^3.0.0",
    "@obsidion/contracts": "workspace:*",
    "@obsidion/core": "workspace:*",
    "@obsidion/proving-progress": "workspace:*",
    "@oxide/l1-contracts": "workspace:*",
    "@oxide/oxide-client": "workspace:*",
    "@oxide/oxide-lib": "workspace:*",
    "@shield-labs/utils": "0.1.0",
    "@xmtp/content-type-primitives": "^2.0.2",
    "@zkpassport/poseidon2": "0.6.2",
    "buffer": "^6.0.3",
    "cbor-x": "^1.6.4",
    "dotenv": "^16.4.7",
    "eventemitter3": "^5.0.1",
    "lodash-es": "^4.17.21",
    "ox": "^0.6.9",
    "ts-essentials": "^10.0.4",
    "ts-node": "10.9.1",
    "typescript": "5.7.3",
    "viem": "npm:@aztec/viem@2.38.2",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.5",
    "webauthn-p256": "^0.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aztec/bb.js": "v5.2.0",
    "@aztec/noir-noir_js": "v5.2.0",
    "@aztec/standard-contracts": "v5.2.0",
    "@obsidion/oxide-build": "workspace:*",
    "@oxide/tee-enclave": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.19.83",
    "@vitest/coverage-v8": "2.1.9",
    "@xmtp/node-sdk": "^4.5.0",
    "fake-indexeddb": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.21.0"
  }
}
