{
  "name": "@obsidion/contracts",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "author": "porco",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b",
    "clean": "rm -rf ./dist .tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "recompile:paylinks": "tsx scripts/recompile-paylinks.ts"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "v6.0.0",
    "@aztec-labs/accounts": "v6.0.0",
    "@aztec-labs/foundation": "v6.0.0",
    "@aztec-labs/pxe": "v6.0.0",
    "@aztec-labs/stdlib": "v6.0.0",
    "@aztec-labs/wallet-sdk": "v6.0.0",
    "@obsidion/core": "workspace:*"
  },
  "devDependencies": {
    "@obsidion/oxide-build": "workspace:*",
    "@types/node": "^18.7.23",
    "@vitest/coverage-v8": "^2.1.5",
    "tsx": "^4.7.0",
    "typescript": "5.7.3",
    "vitest": "^2.1.5"
  }
}
