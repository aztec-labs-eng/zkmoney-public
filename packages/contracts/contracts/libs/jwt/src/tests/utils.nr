/// Helper to create JWT input with a custom base64_decode_offset for testing offset attacks
pub fn setup_jwt_with_custom_offset(custom_offset: u32) -> JWTInput {
    let jwt_input = setup_jwt_input();

    JWTInput {
        header_and_payload: jwt_input.header_and_payload,
        base64_decode_offset: custom_offset,
        signature_limbs: jwt_input.signature_limbs,
        public_key_e: jwt_input.public_key_e,
