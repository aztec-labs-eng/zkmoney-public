{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "paths": {
      "src/*": ["./src/*"],
      "@zkpassport/*": ["./node_modules/@zkpassport/*"]
    }
  },
  "include": ["src", "src/**/*.json", "src/**/*.jpeg", "src/**/*.png"],
  "exclude": ["node_modules"]
}
