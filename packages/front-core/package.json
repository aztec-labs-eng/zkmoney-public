  "version": "0.1.0",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -r src/assets dist/assets && tsc -b && tsc-alias",
    "clean": "rm -rf ./dist .tsbuildinfo",
    "test": "vitest run",
    "test:anvil": "vitest run -c vitest.anvil.config.ts",
    "test:testnet:tee-smoke": "vitest run -c vitest.testnet.config.ts",
    "test:e2e:reorg": "vitest run -c vitest.e2e.config.ts test/e2e/reorgSandbox.e2e.ts",
    "test:e2e:requests": "vitest run -c vitest.e2e.config.ts test/e2e/requestMetaFulfillment.e2e.ts",
    "test:e2e:transfer-scan": "vitest run -c vitest.e2e.config.ts test/e2e/webWalletTransferScan.e2e.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
