VITE_NODE_URL=
VITE_NODE_API_KEY=
VITE_L1_RPC_URL=
VITE_ACCOUNT_SERVICE_URL=https://account.zk.money
VITE_PASSKEY_ENVIRONMENT=production
DESKTOP_PAGE_HOSTNAME=wallet.zk.money
VITE_CAMPAIGN_URL=https://launch.zk.money
VITE_GOOGLE_CLIENT_ID=344670707814-i0j7sbjn7frhorb8nr2g7oekc7maus4n.apps.googleusercontent.com
VITE_PREDICATE_CHAIN=ethereum
VITE_PREDICATE_VERIFICATION_HASH=x-managed-policy-a11a9263d6c60699de56386cd8e16773
