# Network target baked into the desktop wallet bundle by scripts/build-web.sh.
# Shell environment wins over this file.
# The committed values are web-wallet's own local defaults (src/config/env.ts): a
# sandbox target that works out of the box against `aztec start --local-network`.
# A deployment/packaging pipeline overrides them for a real tier via shell env,
# exactly as .github/workflows/deploy-web-wallet.yml maps GitHub vars/secrets onto
# .env.production — see packages/web-wallet/README.md §Deploy for the testnet values.
VITE_NETWORK=sandbox
VITE_NODE_URL=http://localhost:8080
# Only when the node sits behind an API gateway (which 403s unauthenticated calls).
VITE_NODE_API_KEY=
VITE_L1_RPC_URL=http://localhost:8545
# The config profile the wallet boots from, and the id that document must declare.
VITE_CONFIG_PROFILE_URL=http://localhost:8083/profiles/sandbox.json
VITE_CONFIG_EXPECTED_PROFILE_ID=sandbox
# Leave it empty to use the default /svc/account; the local server proxies it
# (config/default.json).
VITE_ACCOUNT_SERVICE_URL=
# Deployment identity is independent of the network and page hostname.
VITE_PASSKEY_ENVIRONMENT=local
DESKTOP_PAGE_HOSTNAME=localhost
# Optional; empty leaves the analytics client a no-op.
VITE_ZKMONEY_API_URL=
