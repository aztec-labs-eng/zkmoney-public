{
  "name": "web-wallet-desktop",
  "version": "0.1.0",
  "description": "Runs the built web wallet on a loopback HTTPS server and launches Chrome so the production origin (and its passkeys) resolve locally. Deliberately NOT a pnpm workspace member — own npm lockfile, like packages/backend/oxide-relayer.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "setup": "npm install --workspaces=false",
    "build:web": "./scripts/build-web.sh",
    "start": "electron .",
    "test": "node --test scripts/config.test.js && node scripts/smoke-test.js",
    "check": "node --check src/main.js && node --check src/config.js && node --check src/tls.js && node --check src/server.js && node --check src/proxy.js && node --check src/chrome.js && node --check scripts/smoke-test.js && node --check scripts/compose-config.js && node --check scripts/write-build-meta.mjs",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder --mac dmg zip --win nsis --linux AppImage",
    "build": "pnpm run check"
  },
  "dependencies": {
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.11.1"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "money.zk.wallet.desktop",
    "productName": "zk.money Desktop",
    "asar": true,
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      },
      {
        "from": "build-meta.json",
        "to": "build-meta.json"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "zkmoney-desktop-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "zk.money Desktop ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "zkmoney-desktop-windows-setup.${ext}"
    },
    "linux": {
      "category": "Finance",
      "target": [
        "AppImage"
      ],
      "artifactName": "zkmoney-desktop-linux-${arch}.${ext}"
    }
  }
}
