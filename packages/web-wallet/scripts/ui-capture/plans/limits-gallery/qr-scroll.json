      "state": "Privacy notice before the address"
    },
    {
      "action": "click",
      "testId": "deposit-privacy-continue"
    },
    {
      "action": "waitFor",
      "testId": "address-limits"
    },
    {
      "action": "screenshot",
      "file": "02-address.png",
      "state": "Address with its QR, then the Limits and fees line"
    },
    {
      "action": "scroll",
      "selector": "dialog:modal .ww-modal",
      "top": "end"
    },
    {
      "action": "screenshot",
      "file": "05-address-after-scroll.png",
      "state": "Address sheet at its end"
    },
    {
      "action": "reachable",
      "selector": "[data-testid=\"address-limits\"] button[aria-expanded]"
    },
    {
      "action": "screenshot",
      "file": "06-address-actions.png",
      "state": "Deposit address controls are reachable after scrolling"
    }
  ]
