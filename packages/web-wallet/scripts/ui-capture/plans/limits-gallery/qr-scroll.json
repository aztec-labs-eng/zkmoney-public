{
  "scenario": "activity",
  "path": "/deposit?flowFixture=success",
  "finalScreenshot": false,
  "steps": [
    {
      "action": "click",
      "testId": "deposit-show-address"
    },
    {
      "action": "click",
      "testId": "deposit-chain-31337"
    },
    {
      "action": "click",
      "testId": "picker-DAI"
    },
    {
      "action": "waitFor",
      "selector": ".ww-deposit-disclaimer"
    },
    {
      "action": "screenshot",
