    { "action": "waitFor", "role": "dialog", "name": "Move details" },
    { "action": "screenshot", "file": "switched-done.png", "state": "A switch that landed" },
    { "action": "press", "role": "dialog", "name": "Move details", "key": "Escape" },
    { "action": "click", "role": "button", "name": "Open move details", "nth": 2 },
    { "action": "waitFor", "role": "dialog", "name": "Move details" },
