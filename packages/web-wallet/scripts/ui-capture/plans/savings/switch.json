    { "action": "click", "testId": "move-change-to" },
    { "action": "waitFor", "selector": "[role=listbox]" },
    { "action": "click", "selector": "[role=listbox] > button:nth-of-type(3)" },
    { "action": "waitFor", "selector": "dialog button:has-text(\"Review\"):enabled" },
    {
      "action": "screenshot",
      "file": "switch-lower.png",
      "state": "To the DAI vault at a lower rate"
    },
    { "action": "click", "testId": "move-change-to" },
    { "action": "waitFor", "selector": "[role=listbox]" },
