{
  "scenario": "activity",
  "path": "/deposit?flowFixture=success",
  "steps": [
    {
      "action": "click",
      "testId": "deposit-new-address"
    },
    {
      "action": "click",
      "testId": "deposit-chain-31337"
    },
    {
      "action": "click",
      "testId": "picker-USDC"
    },
    {
      "action": "waitFor",
      "label": "Amount to receive"
    },
    {
      "action": "fill",
      "label": "Amount to receive",
      "value": "4999.76"
    },
    {
      "action": "waitFor",
      "testId": "limit-notice"
    },
    {
      "action": "hover",
      "selector": "dialog[open] :has(> button:disabled:has-text(\"Review\"))"
    },
    {
      "action": "screenshot",
      "file": "usdc-over-cta.png",
      "state": "USDC one cent over the gross limit: the disabled action scrolled into view"
    },
    {
      "action": "press",
      "testId": "limit-notice-use-maximum",
      "key": "Enter"
    },
    {
      "action": "waitFor",
      "selector": "dialog:modal input[aria-label=\"Amount to receive\"][value=\"4999.75\"]"
    },
    {
      "action": "waitFor",
      "testId": "limit-notice",
      "state": "detached"
    },
    {
      "action": "waitFor",
      "selector": "dialog[open] button:enabled:has-text(\"Review\")"
    },
    {
      "action": "waitFor",
      "selector": "dialog:modal [data-testid=\"funding-capacity-panel\"].ww-capacity--quiet",
      "state": "attached"
    },
    {
      "action": "hover",
      "selector": "dialog[open] button:enabled:has-text(\"Review\")"
    },
    {
      "action": "screenshot",
      "file": "usdc-at-limit.png",
      "state": "USDC at the limit: its conversion credit is unknown, so nothing is said about capacity and Review is available"
    }
  ],
  "finalScreenshot": false,
  "recordHoldMs": 0
}
