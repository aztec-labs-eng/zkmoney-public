{
  "scenario": "activity",
  "path": "/withdraw/fresh?flowFixture=success&balanceFixture=10000",
  "steps": [
    {
      "action": "fill",
      "testId": "withdraw-address",
      "value": "0x7777777777777777777777777777777777777777"
    },
    {
      "action": "fill",
      "label": "Name this address",
      "value": "Weekend savings wallet"
    },
    {
      "action": "waitFor",
      "selector": "[data-testid=\"withdraw-address-continue\"]:enabled"
    },
    {
      "action": "click",
      "testId": "withdraw-address-continue"
    },
    {
      "action": "waitFor",
      "testId": "withdraw-amount"
    },
    {
      "action": "screenshot",
      "file": "limits-before-typing.png",
      "state": "amount before typing"
    },
    {
      "action": "click",
      "role": "button",
      "name": "MAX",
      "exact": true
    },
    {
      "action": "waitFor",
      "selector": "[data-testid=\"withdraw-amount\"][value=\"5000\"]"
    },
    {
      "action": "screenshot",
      "file": "max.png",
      "state": "MAX with a 10,000 balance"
    },
    {
      "action": "fill",
      "testId": "withdraw-amount",
      "value": "5000.01"
    },
    {
      "action": "waitFor",
      "testId": "limit-notice"
    },
    {
      "action": "waitFor",
      "selector": "dialog[open] [data-testid=\"withdraw-amount-continue\"]:disabled"
    },
    {
      "action": "screenshot",
      "file": "over-limit.png",
      "state": "one cent over the $5,000 limit"
    },
    {
      "action": "hover",
      "selector": "dialog[open] :has(> [data-testid=\"withdraw-amount-continue\"]:disabled)"
    },
    {
      "action": "screenshot",
      "file": "over-limit-cta.png",
      "state": "one cent over: the disabled action scrolled into view"
    },
    {
      "action": "press",
      "testId": "limit-notice-use-maximum",
      "key": "Enter"
    },
    {
      "action": "waitFor",
      "selector": "[data-testid=\"withdraw-amount\"][value=\"5000\"]"
    },
    {
      "action": "waitFor",
      "testId": "limit-notice",
      "state": "detached"
    },
    {
      "action": "press",
      "testId": "withdraw-amount-continue",
      "key": "Enter"
    },
    {
      "action": "waitFor",
      "testId": "withdraw-gas-continue"
    },
    {
      "action": "click",
      "selector": "[role=\"group\"][aria-label=\"ETH for gas\"] button:has-text(\"None\")"
    },
    {
      "action": "click",
      "testId": "withdraw-gas-continue"
    },
    {
      "action": "reachable",
      "testId": "withdraw-confirm"
    },
    {
      "action": "screenshot",
      "file": "review-at-limit.png",
      "state": "review at the limit"
    }
  ],
  "finalScreenshot": false,
  "recordHoldMs": 0
}
