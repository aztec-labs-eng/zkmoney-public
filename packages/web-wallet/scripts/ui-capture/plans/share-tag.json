      "state": "Generating a fresh connect link"
    },
    {
      "action": "waitFor",
      "selector": ".ww-qr-card__code"
    },
    {
      "action": "screenshot",
      "file": "share-ready.png",
      "state": "Full connect link QR and sharing controls"
    },
    {
      "action": "reachable",
      "role": "button",
      "name": "Copy link",
      "exact": true,
      "selector": ".ww-share-tag-modal :is(button, [role=\"button\"]):has-text(\"Copy link\")"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Copy link",
      "exact": true,
      "selector": ".ww-share-tag-modal :is(button, [role=\"button\"]):has-text(\"Copy link\")"
    },
    {
      "action": "screenshot",
      "file": "share-copied.png",
      "state": "Copy link confirmation"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Close",
      "exact": true
    }
  ],
  "finalScreenshot": false
