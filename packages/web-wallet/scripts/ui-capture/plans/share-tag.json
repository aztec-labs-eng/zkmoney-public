{
  "scenario": "activity",
  "path": "/",
  "ready": {
    "testId": "wallet-balance"
  },
  "steps": [
    {
      "action": "click",
      "role": "button",
      "name": "Open menu",
      "exact": true
    },
    {
      "action": "click",
      "role": "button",
      "name": "Share @tag",
      "exact": true,
      "first": true
    },
    {
      "action": "waitFor",
      "role": "dialog",
      "name": "Share @tag"
    },
    {
      "action": "screenshot",
