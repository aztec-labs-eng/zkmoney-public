{
  "scenario": "activity",
  "path": "/",
  "ready": {
    "testId": "wallet-balance"
  },
  "steps": [
    {
      "action": "screenshot",
      "file": "home.png",
      "state": "Populated Home"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Notifications",
      "exact": true
    },
    {
      "action": "screenshot",
      "file": "notifications.png",
      "state": "Phone Notifications sheet"
    },
    {
      "action": "press",
      "role": "dialog",
      "name": "Notifications",
      "exact": true,
      "key": "Escape"
    },
    {
      "action": "reachable",
      "selector": ".ww-home-txns"
    },
    {
      "action": "screenshot",
      "file": "transactions.png",
      "state": "Populated Home transaction widget"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Pending",
      "exact": true
    },
    {
      "action": "reachable",
      "selector": ".ww-home-txns"
    },
    {
      "action": "screenshot",
      "file": "pending.png",
      "state": "Pending activity"
    },
    {
      "action": "fill",
      "label": "Search @tag",
      "value": "ada"
    },
    {
      "action": "waitFor",
      "selector": ".ww-search__results"
    },
    {
      "action": "screenshot",
      "file": "search.png",
      "state": "Home search results"
    },
    {
      "action": "press",
      "label": "Search @tag",
      "key": "Escape"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Open menu",
      "exact": true
    },
    {
      "action": "waitFor",
      "role": "dialog",
      "name": "Wallet menu"
    },
    {
      "action": "screenshot",
      "file": "menu.png",
      "state": "Primary menu"
    },
    {
      "action": "reachable",
      "role": "button",
      "name": "Settings",
      "exact": true
    },
    {
      "action": "reachable",
      "role": "button",
      "name": "Log out",
      "exact": true
    },
    {
      "action": "screenshot",
      "file": "menu-end.png",
      "state": "Menu final actions reached by scrolling"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Close menu",
      "exact": true
    },
    {
      "action": "click",
      "role": "button",
      "name": "View all",
      "exact": true
    },
    {
      "action": "waitForUrl",
      "url": "**/activity"
    },
    {
      "action": "screenshot",
      "file": "activity.png",
      "state": "View all routes to Activity"
    }
  ],
  "finalScreenshot": false
}
