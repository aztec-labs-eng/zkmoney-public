{
  "name": "@obsidion/web-wallet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scan-qr": "vitest run --config vitest.scan-qr.config.ts",
    "ui:capture": "node scripts/ui-capture/capture.mjs",
    "test:ui-capture": "node --test --test-concurrency=1 scripts/ui-capture/test/*.test.mjs",
    "test:contacts-layout": "node --test --test-concurrency=1 test/browser/contactsGeometry.browser.mjs",
    "test:wallet-modal": "node --test test/browser/rainbowkitModal.browser.mjs",
    "test:modal-badges": "node --test --test-concurrency=1 test/browser/modalBadges.browser.mjs",
    "test:qr-sheets": "node --test --test-concurrency=1 test/browser/qrSheets.browser.mjs",
    "test:phone-sheets": "node --test --test-concurrency=1 test/browser/phoneSheets.browser.mjs",
    "test:in-app-host-bar": "node --test --test-concurrency=1 test/browser/inAppHostBar.browser.mjs",
    "test:ticket-layout": "node --test test/browser/ticketTagStep.browser.mjs",
    "test:active-tab": "node --test --test-concurrency=1 test/browser/activeTab.browser.mjs",
    "test:qr": "vitest run --config vitest.qr.config.ts",
    "test:passkey-rp-browser": "node test/browser/passkeyRp.browser.mjs"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "v6.0.0",
    "@aztec-foundation/bb.js": "v6.0.0",
    "@aztec-labs/foundation": "v6.0.0",
    "@aztec-labs/kv-store": "v6.0.0",
    "@aztec-foundation/l1-artifacts": "v6.0.0",
    "@aztec-foundation/noir-acvm_js": "v6.0.0",
    "@aztec-foundation/noir-noirc_abi": "v6.0.0",
    "@aztec-labs/stdlib": "v6.0.0",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.7.0",
    "@obsidion/config-client": "workspace:*",
    "@obsidion/contracts": "workspace:*",
    "@obsidion/core": "workspace:*",
    "@obsidion/front-core": "workspace:*",
    "@obsidion/generation-v5": "workspace:*",
    "@obsidion/passkey-web": "workspace:*",
    "@obsidion/proving-progress": "workspace:*",
    "@obsidion/sdk": "workspace:*",
    "@obsidion/web-ds": "workspace:*",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5",
    "@xmtp/browser-sdk": "7.0.0",
    "blo": "^2.1.1",
    "jsqr": "1.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^6.30.0",
    "uqr": "0.1.3",
    "viem": "2.57.1",
    "wagmi": "^2"
  },
  "devDependencies": {
    "@aztec-labs/sqlite3mc-wasm": "v6.0.0",
    "@obsidion/metrics-policy": "workspace:*",
    "@oxide/l1-contracts": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^18.7.23",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "buffer": "^6.0.3",
    "jsdom": "^25.0.1",
    "typescript": "5.7.3",
    "vite": "^8.0.10",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^2.1.5",
    "zone.js": "^0.16.1"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
