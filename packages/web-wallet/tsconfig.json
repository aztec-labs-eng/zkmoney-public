{
  "extends": "@obsidion/lint-config/tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleDetection": "force",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/app.tsbuildinfo",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@obsidion/web-ds": [
        "../design-system/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts/ui-capture/fixtures"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "e2e",
    "test/integration"
  ]
}
