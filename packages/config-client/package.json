{
  "name": "@obsidion/config-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json",
    "clean": "rm -rf ./dist .tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@obsidion/core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@obsidion/lint-config": "workspace:*",
    "@types/node": "^22.19.6",
    "typescript": "5.7.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
