{
  "name": "@obsidion/passkey-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.build.json",
    "clean": "rm -rf ./dist .tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && eslint --max-warnings 0",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@obsidion/core": "workspace:*"
  },
  "devDependencies": {
    "@noble/hashes": "^1.7.0",
    "@obsidion/lint-config": "workspace:*",
    "@types/node": "^22.19.6",
    "eslint": "^9.36.0",
    "jsdom": "^25.0.1",
    "typescript": "5.7.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
