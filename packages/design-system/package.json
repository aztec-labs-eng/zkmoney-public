{
  "name": "@obsidion/web-ds",
  "version": "0.1.0",
  "private": true,
  "description": "zk.money web design system + Storybook (source of truth; synced to claude.ai/design)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cat src/styles/styles.css src/styles/cards-modals.css > dist/styles.css",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@samasante/liquid-glass": "^0.1.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "storybook": "^10.5.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.5"
  },
  "license": "MIT"
}
