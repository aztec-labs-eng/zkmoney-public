{
  "extends": ["../../tsconfig.json", "@obsidion/lint-config/tsconfig.strict.json"],
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    // Platform-neutral: no DOM types.
    "lib": ["ES2022"]
  },
  "include": [
    "src/types/index.ts",
    "src/constants/index.ts",
    "src/oxide/index.ts",
    "src/oxide/manifestEntriesCli.ts",
    "src/text/index.ts",
    "src/errors/index.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
