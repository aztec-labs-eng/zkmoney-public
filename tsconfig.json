{
  "compilerOptions": {
    // Modern JS target and module
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // Interop and helpers
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Strictness
    "strict": true,

    // Allow .ts files (e.g. tests) to import .tsx sources when TS falls back to this config
    "jsx": "react-jsx",

    // Source maps and declarations (override in packages as needed)
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}
