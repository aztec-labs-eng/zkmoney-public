+// The checks only the private kernels make, which kernelless proving would otherwise skip: the tx's gas against
+// its limits, a static call's lack of side effects, the tx's key validation requests and a fee payer (the tail).
+// Messages are the kernels' own.
+function assertKernelOnlyChecks(txRequest, privateExecutionResult, publicInputs) {
+    const executions = [
+        privateExecutionResult.entrypoint
+    ];
+    let keyValidationRequests = 0;
+    while(executions.length !== 0){
+        const execution = executions.shift();
+        executions.push(...execution.nestedExecutionResults);
+        const call = execution.publicInputs;
+        keyValidationRequests += call.keyValidationRequestsAndSeparators.claimedLength;
+        if (!call.callContext.isStaticCall) continue;
+        for (const [name, items] of [
+            ['note_hashes', call.noteHashes],
+            ['nullifiers', call.nullifiers],
+            ['l2_to_l1_msgs', call.l2ToL1Msgs],
+            ['private_logs', call.privateLogs],
+            ['contract_class_logs_hashes', call.contractClassLogsHashes]
+        ]){
+            if (items.claimedLength !== 0) throw new Error(`${name} must be empty for static calls`);
+        }
+        if (call.privateCallRequests.getActiveItems().some((request)=>!request.callContext.isStaticCall)) {
+            throw new Error('static call cannot make non-static private calls');
+        }
+        if (call.publicCallRequests.getActiveItems().some((request)=>!request.inner.isStaticCall)) {
+            throw new Error('static call cannot enqueue non-static public calls');
+        }
+        if (!call.publicTeardownCallRequest.isEmpty() && !call.publicTeardownCallRequest.isStaticCall) {
+            throw new Error('static call cannot set a non-static teardown');
+        }
+        if (call.isFeePayer) throw new Error('static call cannot nominate itself as fee payer');
+    }
+    if (keyValidationRequests > MAX_KEY_VALIDATION_REQUESTS_PER_TX) {
+        throw new Error(`key_validation_requests exceed the per-tx maximum (${keyValidationRequests} > ${MAX_KEY_VALIDATION_REQUESTS_PER_TX})`);
+    }
+    if (publicInputs.feePayer.isZero()) throw new Error("Fee payer can't be empty");
+    if (publicInputs.gasUsed.gtAny(txRequest.txContext.gasSettings.gasLimits)) {
+        throw new Error('The gas used exceeds the gas limits');
+    }
+}
