{
  "name": "@oxide/oxide-relayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": "./dest/bin/oxide-relayer.js",
  "exports": {
    ".": "./dest/index.js",
    "./*": "./dest/*"
  },
  "scripts": {
    "build": "rm -rf dest && tsc -p tsconfig.json",
    "start": "node ./dest/bin/oxide-relayer.js run",
    "lint": "../node_modules/.bin/eslint --cache ./src",
    "lint:fix": "../node_modules/.bin/eslint --cache --fix ./src",
    "test": "NODE_NO_WARNINGS=1 node --experimental-vm-modules ../node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@aztec/aztec.js": "5.2.0",
    "@aztec/constants": "5.2.0",
    "@aztec/ethereum": "5.2.0",
    "@aztec/foundation": "5.2.0",
    "@aztec/stdlib": "5.2.0",
    "@oxide/l1-contracts": "workspace:^",
    "@oxide/noir-contracts.js": "workspace:^",
    "@oxide/oxide-client": "workspace:^",
    "@oxide/oxide-lib": "workspace:^",
    "@oxide/telemetry": "workspace:^",
    "@oxide/watcher-lib": "workspace:^",
    "commander": "^15.0.0",
    "ethers": "^6.13.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "viem": "npm:@aztec/viem@2.38.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@swc/core": "^1.10.12",
    "@swc/jest": "^0.2.36",
    "@types/node": "^22.15.17",
    "jest": "^30.0.0",
    "typescript": "^5.3.3"
  }
}
