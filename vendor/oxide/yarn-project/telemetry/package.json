{
  "name": "@oxide/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dest/index.js",
  "types": "./dest/index.d.ts",
  "exports": {
    ".": {
      "types": "./dest/index.d.ts",
      "import": "./dest/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dest && tsc -p tsconfig.build.json",
    "lint": "../node_modules/.bin/eslint --cache ./src",
    "lint:fix": "../node_modules/.bin/eslint --cache --fix ./src",
    "test": "tsc -p tsconfig.json --noEmit && NODE_NO_WARNINGS=1 node --experimental-vm-modules ../node_modules/.bin/jest"
  },
  "dependencies": {
    "@aztec/foundation": "5.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.55.0",
    "@opentelemetry/resources": "1.28.0",
    "@opentelemetry/sdk-metrics": "1.28.0",
    "@opentelemetry/semantic-conventions": "1.28.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@swc/core": "^1.10.12",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.17",
    "jest": "^30.0.0",
    "typescript": "^5.3.3"
  }
}
