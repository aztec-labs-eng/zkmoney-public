mod comb_table;
mod fixed_base;
mod helpers;

use aztec::protocol::{address::AztecAddress, hash::sha256_to_field};
use bigcurve::{BigCurve, curves::secp256k1::{Secp256k1, Secp256k1Scalar}};
use bignum::Secp256k1_Fr;

use crate::fixed_base::{fixed_base_mul, nibbles_be};
use crate::helpers::{field_digest_to_scalar, fields_to_be_bytes, K1Point, K1Scalar, point_to_be_bytes};
use oxide_lib::constants::{DOM_SEP__STEALTH_K, MAX_NONCE};
use oxide_lib::recipient_commitment::compute_recipient_commitment;

struct ResolutionPublicInputs {
    recipient_commitment: Field,
    shared_secret_salt: Field,
    user_public_key: K1Point,
    user_l2_address: AztecAddress,
    resolver_public_key: K1Point,
    day: u32,
}

fn compute_shared_secret_salt(
    day: u32,
    nonce: u32,
    user_public_key: Secp256k1,
    resolver_private_key: Secp256k1Scalar,
) -> Field {
    // k = hash(DOM_SEP || day || nonce), folded into the K1 scalar field.
    let k = field_digest_to_scalar(sha256_to_field(fields_to_be_bytes([DOM_SEP__STEALTH_K, day as Field, nonce as Field])));

    // shared_point = user_public_key * (resolver_private_key * k)
    let resolver_priv_fr: Secp256k1_Fr = resolver_private_key.into_bignum();
    let k_fr: Secp256k1_Fr = k.into_bignum();
    let combined_scalar = Secp256k1Scalar::from_bignum(resolver_priv_fr * k_fr);
    let shared_point = user_public_key.mul(combined_scalar);

    // shared_secret_salt = hash(shared_point.x || shared_point.y)
    sha256_to_field(point_to_be_bytes(shared_point))
}

/// Proves the resolver derived the SIPA's shared secret salt from the two registered keys and the day.
///
/// Also computes the recipient commitment but this could be done in the Account Registry instead, since
/// the recipient is revealed to the L1 node, but poseidon2 costs only ~70 gates in-circuit versus a new Solidity
/// dependency.
fn main(
    day: u32,
    user_public_key: K1Point,
    resolver_public_key: K1Point,
    user_l2_address: AztecAddress,
    resolver_private_key: K1Scalar,
    nonce: u32,
) -> pub ResolutionPublicInputs {
    assert(nonce < MAX_NONCE, "nonce out of range");

    // Both public keys are validated to be on the curve in AccountMetadataRegistry.sol when the record is written. Since these keys
    // are a public input that gets checked against those values we don't need to perform the validation here.
    let user_pk = user_public_key.to_secp256k1();
    let resolver_pk = resolver_public_key.to_secp256k1();

    let resolver_priv = resolver_private_key.to_scalar();

    // Assert that `resolver_private_key` is the discrete log of `resolver_public_key`.
    let derived_resolver_pk = fixed_base_mul(nibbles_be(resolver_private_key.to_be_bytes()));
    assert(derived_resolver_pk.eq(resolver_pk), "resolver pk mismatch");

    let shared_secret_salt = compute_shared_secret_salt(day, nonce, user_pk, resolver_priv);
    let recipient_commitment = compute_recipient_commitment(shared_secret_salt, user_l2_address);

    ResolutionPublicInputs {
        recipient_commitment,
        shared_secret_salt,
        user_public_key,
        user_l2_address,
        resolver_public_key,
        day,
    }
}

mod test {
    use crate::{helpers::{K1Point, K1Scalar}, main, MAX_NONCE, ResolutionPublicInputs};
    use aztec::protocol::address::AztecAddress;
    use aztec::protocol::traits::FromField;

    // A complete, self-consistent set of circuit inputs together with the values it should produce.
    // `valid()` returns the canonical vector; each negative test starts from it and corrupts
    // exactly one field. Mirrored by the fixture in yarn-project/resolver-lib/src/resolution.test.ts.
    struct Fixture {
        shared_secret_salt: Field,
        recipient_commitment: Field,
        day: u32,
        user_public_key: K1Point,
        resolver_public_key: K1Point,
        user_l2_address: AztecAddress,
        resolver_private_key: K1Scalar,
        nonce: u32,
    }

    impl Fixture {
        fn run(self) -> ResolutionPublicInputs {
            main(
                self.day,
                self.user_public_key,
                self.resolver_public_key,
                self.user_l2_address,
                self.resolver_private_key,
                self.nonce,
            )
        }
    }

    // Generated by https://gist.github.com/defkit/29e34b3101a879beccc7ad0a5ab4159f. A self-consistent valid resolution.
    fn valid() -> Fixture {
        Fixture {
            shared_secret_salt: 0x00bbabe215b1c7a1ccf8abc5196bd9bcd584403fcaad9322edda988f9899e7fb,
            recipient_commitment: 0x2d2b85117fb7b9c18c24f74d964a952070dc83713469c0493c8ac1bcbed0e171,
            day: 20000,
            user_public_key: K1Point {
                xhi: 0x88e2ddeb04657dbd0edadf9c1f98da3b,
                xlo: 0x3895faa1f00527934dd35d17542ffe9b,
                yhi: 0x1e7640d7737e24e36d208effb77e86af,
                ylo: 0xfe670a9a497aa7fb52bf4e687a17fff4,
            },
            resolver_public_key: K1Point {
                xhi: 0xbb50e2d89a4ed70663d080659fe0ad4b,
                xlo: 0x9bc3e06c17a227433966cb59ceee020d,
                yhi: 0xecddbf6e00192011648d13b1c00af770,
                ylo: 0xc0c1bb609d4d3a5c98a43772e0e18ef4,
            },
            user_l2_address: AztecAddress::from_field(
                0x0ead00000000000000000000000000000000000000000000000000000000bee0,
            ),
            resolver_private_key: K1Scalar {
                scalar_hi: 0x1234567890abcdef1234567890abcdef,
                scalar_lo: 0x1234567890abcdef1234567890abcdef,
            },
            nonce: 42,
        }
    }

    #[test]
    fn generated_valid_resolution() {
        let f = valid();
        let resolution = f.run();
        assert_eq(resolution.shared_secret_salt, f.shared_secret_salt);
        assert_eq(resolution.recipient_commitment, f.recipient_commitment);
    }

    #[test(should_fail_with = "nonce out of range")]
    fn nonce_at_max_is_rejected() {
        let mut f = valid();
        f.nonce = MAX_NONCE;
        let _ = f.run();
    }

    #[test(should_fail_with = "resolver pk mismatch")]
    fn resolver_public_key_must_match_private_key() {
        let mut f = valid();
        // A valid on-curve point, but not G * resolver_private_key.
        f.resolver_public_key = f.user_public_key;
        let _ = f.run();
    }
}
