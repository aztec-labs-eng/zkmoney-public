.tflint-venv/

# Generated by `aztec-nargo test` / `aztec-nargo check` — a per-test input
# scaffold. Local-only; the actual test inputs live in src/.
Prover.toml

# `forge coverage --report lcov` output. Uploaded as a CI artifact;
# never committed.
lcov.info

# Build-local resolver verifier, regenerated from the current toolchain's circuit build. The deployed
# verifier is the committed l1-contracts/src/pinned/PinnedResolverVerifier.sol; repin via
# noir-projects/resolver_circuit/repin.sh.
l1-contracts/src/generated/ResolverVerifier.sol

# Local outputs of enclave/build.sh + enclave/test/reproduce.sh. Ephemeral build
# artifacts (image id, EIF, measurements, and reproduce.sh's per-build copies);
# the real values are published from a Nitro host, never committed.
enclave/image.id
enclave/image.id.*
enclave/oxide-tee.eif
enclave/measurements.json
enclave/measurements.json.*
enclave/eif.sha256.*

# Benchmark reports (yarn workspace @oxide/end-to-end run test:bench)
bench-out/

# Per-issue scratch directories (logs, captured artifacts, ad-hoc setup scripts)
# used during manual ops + dry-runs. Convention: `.gk-<linear-id>/` at repo root.
# Anything worth preserving is lifted into the tree before the dir is discarded.
.gk-*/
