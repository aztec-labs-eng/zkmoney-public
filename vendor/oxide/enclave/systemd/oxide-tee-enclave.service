[Unit]
Description=Oxide TEE Nitro Enclave
After=nitro-enclaves-allocator.service
Requires=nitro-enclaves-allocator.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Written by host_stage.sh: ENCLAVE_CPU_COUNT / ENCLAVE_MEMORY_MIB computed from the host size
EnvironmentFile=/etc/default/oxide-tee-enclave
ExecStartPre=/usr/bin/nitro-cli terminate-enclave --all
ExecStart=/usr/bin/nitro-cli run-enclave \
    --eif-path /var/lib/oxide-tee/oxide-tee.eif \
    --cpu-count ${ENCLAVE_CPU_COUNT} \
    --memory ${ENCLAVE_MEMORY_MIB} \
    --enclave-cid 16
ExecStop=/usr/bin/nitro-cli terminate-enclave --all
TimeoutStartSec=120
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
